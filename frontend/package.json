{
  "name": "gizmagick-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:manifest": "vite --mode manifest",
    "dev:remote": "vite --mode remote",
    "build": "vite build",
    "build:manifest": "vite build --mode manifest",
    "build:remote": "vite build --mode remote",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "tracks:migrate": "node scripts/track-manifests.mjs migrate",
    "tracks:validate": "node scripts/track-manifests.mjs validate",
    "dev:worker": "wrangler dev --config ../worker/wrangler.toml --local",
    "dev:worker:library": "wrangler dev --config ../worker/wrangler.toml --local --port 8787 --var GIZMAGICK_MEDIA_BASE_URL:http://127.0.0.1:8787/api/library/media",
    "library:seed:local": "node scripts/gizmagick-library-local.mjs",
    "library:migrate:local": "wrangler d1 migrations apply gizmagick-library --config ../worker/wrangler.toml --local",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "miniflare": "5.20260918.0-alpha",
    "vite": "^7.1.2",
    "wrangler": "^4.38.0"
  },
  "allowScripts": {
    "esbuild@0.25.9": true,
    "esbuild@0.25.4": true,
    "sharp@0.33.5": true,
    "workerd@1.20250917.0": true
  }
}
